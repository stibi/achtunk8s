{
  "name": "@achtung/handler-herdr-agent",
  "version": "0.1.0",
  "description": "An Achtung handler that has a coding agent in herdr investigate an alert",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run deadcode && pnpm run dupes && pnpm run test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "deadcode": "knip",
    "dupes": "jscpd src",
    "test": "vitest run"
  },
  "dependencies": {
    "@achtung/handover-sdk": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
